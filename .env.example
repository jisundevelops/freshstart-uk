# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Database (PostgreSQL — Neon.tech recommended)
DATABASE_URL="postgresql://user:password@ep-xxx.eu-west-2.aws.neon.tech/freshstart_uk?sslmode=require"

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET="generate-a-secure-32-char-minimum-secret-here"

# Redis (Upstash)
UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# Seed (development only)
ADMIN_SEED_PASSWORD="ChangeMe123!"

# Cloudinary (blog/guide image uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
